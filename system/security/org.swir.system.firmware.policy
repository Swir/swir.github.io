<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SWIR OS</vendor>
  <vendor_url>https://github.com/Swir/swir.github.io</vendor_url>

  <action id="org.swir.system.firmware.update">
    <description>Install a trusted LVFS firmware update for one device</description>
    <message>Administrator authentication is required to update device firmware.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">root</annotate>
  </action>

  <action id="org.swir.system.firmware.recover">
    <description>Recover or reconcile a journaled SWIR OS firmware transaction</description>
    <message>Administrator authentication is required to recover a firmware transaction.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">root</annotate>
  </action>
</policyconfig>
