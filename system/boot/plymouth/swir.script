Window.SetBackgroundTopColor(0.01, 0.02, 0.06);
Window.SetBackgroundBottomColor(0.00, 0.00, 0.02);

logo = Image.Text("SWIR OS", 0.20, 0.65, 1.00);
logo_sprite = Sprite(logo);
logo_sprite.SetX(Window.GetWidth() / 2 - logo.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo.GetHeight() / 2 - 18);

edition = Image.Text("SYSTEM EDITION", 0.30, 0.72, 1.00);
edition_sprite = Sprite(edition);
edition_sprite.SetX(Window.GetWidth() / 2 - edition.GetWidth() / 2);
edition_sprite.SetY(Window.GetHeight() / 2 + 30);

fun refresh_callback() {
    opacity = 0.55 + 0.35 * Math.Sin(Plymouth.GetTime() * 2.6);
    edition_sprite.SetOpacity(opacity);
}
Plymouth.SetRefreshFunction(refresh_callback);
