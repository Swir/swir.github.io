{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.github.io/system/contracts/package-health.schema.json",
  "title": "SWIR System Package Health 0.1",
  "type": "object",
  "required": ["schema", "packageId", "packageName", "healthy", "checks"],
  "properties": {
    "schema": { "const": "swir.package-health/0.1" },
    "packageId": { "type": ["string", "null"] },
    "packageName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9+._:@-]{0,127}$" },
    "healthy": { "type": "boolean" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "ok"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "ok": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 },
          "resolved": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
