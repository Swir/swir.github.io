{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.example/contracts/system-bootable-image-e2e.schema.json",
  "title": "SWIR Bootable Image UEFI E2E Evidence 0.1",
  "type": "object",
  "required": ["schema", "generatedAt", "distribution", "architecture", "kernelRelease", "bootPath", "partitionTable", "rootFilesystem", "rootFilesystemLabel", "espFilesystem", "espFilesystemLabel", "bootloaderPackage", "bootloaderSha256", "imageSha256", "ovmfSha256", "directKernelBoot", "uefiBootClaim", "bootableImageClaim", "bootloaderE2EClaim", "guestNetworkDisabled", "systemdBooted", "logindActive", "networkManagerActive", "peerAuthorizationSocketActive", "readinessPassed", "wineRuntimeRegistryPassed", "wineRuntimeProvider", "wineRuntimeVersion", "nativeLinuxExecutionPassed", "nativeLinuxExecutionProvider", "nativeLinuxExecutable", "secureBootClaim", "hardwareQualificationClaim", "installerClaim", "recoveryModeClaim"],
  "properties": {
    "schema": { "const": "swir.system-bootable-image-e2e/0.1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "distribution": { "const": "debian-13-trixie" },
    "architecture": { "const": "amd64" },
    "kernelRelease": { "type": "string", "minLength": 1, "maxLength": 256 },
    "bootPath": { "const": "uefi-systemd-boot" },
    "partitionTable": { "const": "gpt" },
    "rootFilesystem": { "const": "ext4" },
    "rootFilesystemLabel": { "const": "SWIR_ROOT" },
    "espFilesystem": { "const": "fat32" },
    "espFilesystemLabel": { "const": "SWIR_ESP" },
    "bootloaderPackage": { "const": "systemd-boot-efi" },
    "bootloaderSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "imageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ovmfSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "directKernelBoot": { "const": false },
    "uefiBootClaim": { "const": true },
    "bootableImageClaim": { "const": true },
    "bootloaderE2EClaim": { "const": true },
    "guestNetworkDisabled": { "const": true },
    "systemdBooted": { "const": true },
    "logindActive": { "const": true },
    "networkManagerActive": { "const": true },
    "peerAuthorizationSocketActive": { "const": true },
    "readinessPassed": { "const": true },
    "wineRuntimeRegistryPassed": { "const": true },
    "wineRuntimeProvider": { "const": "swir.compat.wine" },
    "wineRuntimeVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
    "nativeLinuxExecutionPassed": { "const": true },
    "nativeLinuxExecutionProvider": { "const": "swir.package.system" },
    "nativeLinuxExecutable": { "type": "string", "pattern": "^/usr/bin/" },
    "secureBootClaim": { "const": false },
    "hardwareQualificationClaim": { "const": false },
    "installerClaim": { "const": false },
    "recoveryModeClaim": { "const": false }
  },
  "additionalProperties": false
}
