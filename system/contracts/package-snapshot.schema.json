{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.github.io/system/contracts/package-snapshot.schema.json",
  "title": "SWIR System Package Snapshot 0.1",
  "type": "object",
  "required": ["schema", "capturedAt", "packageId", "manager", "packageName", "installed", "version", "query"],
  "properties": {
    "schema": { "const": "swir.package-snapshot/0.1" },
    "capturedAt": { "type": "string", "minLength": 1 },
    "packageId": { "type": ["string", "null"] },
    "manager": { "enum": ["apt", "dnf", "rpm-ostree", "pacman", "zypper"] },
    "packageName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9+._:@-]{0,127}$" },
    "installed": { "type": "boolean" },
    "version": { "type": ["string", "null"] },
    "query": {
      "type": "object",
      "required": ["source", "exitCode", "signal"],
      "properties": {
        "source": { "enum": ["dpkg-query", "rpm", "pacman"] },
        "exitCode": { "type": "integer" },
        "signal": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "installed": { "const": true } }, "required": ["installed"] },
      "then": { "properties": { "version": { "type": "string", "minLength": 1 } } },
      "else": { "properties": { "version": { "const": null } } }
    }
  ],
  "additionalProperties": false
}
