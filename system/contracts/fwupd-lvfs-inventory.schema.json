{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.example/contracts/fwupd-lvfs-inventory.schema.json",
  "title": "SWIR fwupd/LVFS Inventory 0.1",
  "type": "object",
  "required": ["schema", "available", "readOnly", "mutationCapable", "provider", "trustedRemoteId", "devices", "candidates", "ignoredNonLvfsCandidates", "probe"],
  "properties": {
    "schema": { "const": "swir.fwupd-lvfs-inventory/0.1" },
    "available": { "type": "boolean" },
    "readOnly": { "const": true },
    "mutationCapable": { "const": false },
    "provider": { "const": "fwupd-lvfs" },
    "trustedRemoteId": { "const": "lvfs" },
    "devices": { "type": "array" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["remoteId", "source", "trustedSource", "directDownloadUrlExposed", "mutationAuthorized"],
        "properties": {
          "remoteId": { "const": "lvfs" },
          "trustedSource": { "const": true },
          "directDownloadUrlExposed": { "const": false },
          "mutationAuthorized": { "const": false },
          "source": {
            "type": "object",
            "required": ["class", "repositoryId", "ref"],
            "properties": {
              "class": { "const": "fwupd-lvfs" },
              "repositoryId": { "const": "lvfs" },
              "ref": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "ignoredNonLvfsCandidates": { "type": "integer", "minimum": 0 },
    "probe": { "type": "object" }
  }
}
