{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.github.io/system/contracts/compat-runtime-provisioning-catalog.schema.json",
  "title": "SWIR Windows Compatibility Runtime Provisioning Catalog 0.1",
  "type": "object",
  "required": ["schema", "entries"],
  "properties": {
    "schema": { "const": "swir.compat-runtime-provisioning-catalog/0.1" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["runtimeProvider", "packageManifest"],
        "properties": {
          "runtimeProvider": { "enum": ["swir.compat.wine", "swir.compat.proton"] },
          "channel": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" },
          "packageManifest": { "$ref": "package-provider.schema.json" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
