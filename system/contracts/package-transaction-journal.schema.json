{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.github.io/system/contracts/package-transaction-journal.schema.json",
  "title": "SWIR System Package Transaction Journal 0.1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "state",
    "sequence",
    "createdAt",
    "updatedAt",
    "planDigest",
    "plan",
    "trust",
    "authorization",
    "snapshot",
    "execution",
    "health",
    "recovery",
    "error",
    "history"
  ],
  "properties": {
    "schema": { "const": "swir.system-package-transaction/0.1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$" },
    "state": {
      "enum": [
        "prepared",
        "mutating",
        "verifying",
        "rolling-back",
        "committed",
        "rolled-back",
        "aborted",
        "failed-needs-recovery"
      ]
    },
    "sequence": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "planDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plan": { "$ref": "./distribution-package-plan.schema.json" },
    "trust": {
      "type": "object",
      "required": ["verified", "proofId", "repositoryId"],
      "properties": {
        "verified": { "const": true },
        "proofId": { "type": ["string", "null"] },
        "repositoryId": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": ["grantId", "actorId", "scope"],
      "properties": {
        "grantId": { "type": "string", "minLength": 1 },
        "actorId": { "type": "string", "minLength": 1 },
        "scope": { "const": "packages.mutate" }
      },
      "additionalProperties": false
    },
    "snapshot": { "$ref": "./package-snapshot.schema.json" },
    "execution": { "type": ["object", "null"] },
    "health": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "./package-health.schema.json" }
      ]
    },
    "recovery": {
      "type": "object",
      "required": ["automaticRollbackAvailable", "rollbackCommand"],
      "properties": {
        "automaticRollbackAvailable": { "type": "boolean" },
        "rollbackCommand": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "const": "rpm-ostree" },
                { "const": "rollback" }
              ],
              "items": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "additionalProperties": false
        }
      ]
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state", "at", "detail"],
        "properties": {
          "state": {
            "enum": [
              "prepared",
              "mutating",
              "verifying",
              "rolling-back",
              "committed",
              "rolled-back",
              "aborted",
              "failed-needs-recovery"
            ]
          },
          "at": { "type": "string", "minLength": 1 },
          "detail": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
