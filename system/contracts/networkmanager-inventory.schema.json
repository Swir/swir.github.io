{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.dev/schemas/networkmanager-inventory-0.1.json",
  "title": "SWIR NetworkManager Inventory 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "available", "provider", "mutationCapable", "secretsExposed", "general", "devices", "connections", "accessPoints", "probe"],
  "properties": {
    "schema": { "const": "swir.networkmanager-inventory/0.1" },
    "available": { "type": "boolean" },
    "provider": { "const": "NetworkManager" },
    "mutationCapable": { "type": "boolean" },
    "secretsExposed": { "const": false },
    "wifiScanFailed": { "type": "boolean" },
    "general": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["state", "connectivity", "wifiHardware", "wifi", "wwanHardware", "wwan"],
      "properties": {
        "state": { "type": "string", "maxLength": 64 },
        "connectivity": { "type": "string", "maxLength": 64 },
        "wifiHardware": { "type": "string", "maxLength": 32 },
        "wifi": { "type": "string", "maxLength": 32 },
        "wwanHardware": { "type": "string", "maxLength": 32 },
        "wwan": { "type": "string", "maxLength": 32 }
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ifname", "type", "state", "connection"],
        "properties": {
          "ifname": { "type": ["string", "null"], "maxLength": 64 },
          "type": { "type": "string", "maxLength": 128 },
          "state": { "type": "string", "maxLength": 128 },
          "connection": { "type": ["string", "null"], "maxLength": 512 }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "uuid", "type", "ifname", "active"],
        "properties": {
          "name": { "type": "string", "maxLength": 512 },
          "uuid": { "type": "string", "format": "uuid" },
          "type": { "type": "string", "maxLength": 128 },
          "ifname": { "type": ["string", "null"], "maxLength": 64 },
          "active": { "type": "boolean" }
        }
      }
    },
    "accessPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inUse", "bssid", "ssid", "signal", "security", "ifname", "secretExposed"],
        "properties": {
          "inUse": { "type": "boolean" },
          "bssid": { "type": ["string", "null"], "maxLength": 64 },
          "ssid": { "type": "string", "maxLength": 512 },
          "signal": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
          "security": { "type": ["string", "null"], "maxLength": 256 },
          "ifname": { "type": ["string", "null"], "maxLength": 64 },
          "secretExposed": { "const": false }
        }
      }
    },
    "probe": { "type": "object" }
  }
}
