{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.local/contracts/repository-trust-proof.schema.json",
  "title": "SWIR Repository Trust Proof 0.1",
  "type": "object",
  "required": ["schema", "verified", "proofId", "repositoryId", "nativeRepositoryId", "manager", "distributionId", "packageName", "operation", "signatureVerification", "allowInsecure", "evidence", "policySha256", "verifiedAt"],
  "properties": {
    "schema": { "const": "swir.repository-trust-proof/0.1" },
    "verified": { "const": true },
    "proofId": { "type": "string", "minLength": 8, "maxLength": 160 },
    "repositoryId": { "type": "string", "minLength": 1, "maxLength": 192 },
    "nativeRepositoryId": { "type": "string", "minLength": 1, "maxLength": 192 },
    "manager": { "enum": ["apt", "dnf", "rpm-ostree", "pacman", "zypper"] },
    "distributionId": { "type": "string", "minLength": 1, "maxLength": 192 },
    "packageName": { "type": "string", "minLength": 1, "maxLength": 128 },
    "operation": { "enum": ["install", "update", "remove"] },
    "signatureVerification": { "const": "native-required" },
    "allowInsecure": { "const": false },
    "evidence": { "enum": ["native-read-only-probe", "policy-only-remove"] },
    "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verifiedAt": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
