{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.github.io/system/contracts/linux-driver-foundation-e2e.schema.json",
  "title": "SWIR Linux Driver Foundation E2E 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "generatedAt", "selectedBase", "architecture", "kernelPackage", "firmwarePackage",
    "firmwareDependencies", "kernelModuleTreePresent", "firmwareTreePresent", "liveKernelBoundDevices",
    "liveKernelModules", "primaryDriverSourceClass", "primaryFirmwareSourceClass", "distributionRepositoryOnly",
    "repositorySignatureVerificationRequired", "arbitraryDriverDownloadsAllowed", "windowsKernelDriversSupported",
    "hardwareQualificationClaim", "passed"
  ],
  "properties": {
    "schema": { "const": "swir.linux-driver-foundation-e2e/0.1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "selectedBase": { "const": "debian-13-trixie" },
    "architecture": { "type": "string", "minLength": 1 },
    "kernelPackage": { "$ref": "#/$defs/package" },
    "firmwarePackage": { "$ref": "#/$defs/package" },
    "firmwareDependencies": {
      "type": "object", "additionalProperties": false, "required": ["free", "nonfree"],
      "properties": { "free": { "type": "string", "minLength": 1 }, "nonfree": { "type": "string", "minLength": 1 } }
    },
    "kernelModuleTreePresent": { "const": true },
    "firmwareTreePresent": { "const": true },
    "liveKernelBoundDevices": { "type": "integer", "minimum": 1 },
    "liveKernelModules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "primaryDriverSourceClass": { "const": "kernel-in-tree" },
    "primaryFirmwareSourceClass": { "const": "linux-firmware" },
    "distributionRepositoryOnly": { "const": true },
    "repositorySignatureVerificationRequired": { "const": true },
    "arbitraryDriverDownloadsAllowed": { "const": false },
    "windowsKernelDriversSupported": { "const": false },
    "hardwareQualificationClaim": { "const": false },
    "passed": { "const": true }
  },
  "$defs": {
    "package": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    }
  }
}
