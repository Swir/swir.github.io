{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.example/contracts/catalog-trust-state.schema.json",
  "title": "SWIR System Catalog Trust State 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalogId", "catalogVersion", "sequence", "catalogSha256", "keyId", "generatedAt", "expiresAt", "acceptedAt"],
  "properties": {
    "schema": { "const": "swir.catalog-trust-state/1.0" },
    "catalogId": { "const": "official" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "catalogSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "keyId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "acceptedAt": { "type": "string", "format": "date-time" }
  }
}
