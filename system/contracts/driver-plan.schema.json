{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.github.io/system/contracts/driver-plan.schema.json",
  "title": "SWIR Driver Plan 0.1",
  "type": "object",
  "required": ["schema", "generatedAt", "mode", "readOnly", "autoExecutable", "host", "summary", "operations"],
  "properties": {
    "schema": { "const": "swir.driver-plan/0.1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "mode": { "const": "preview" },
    "readOnly": { "const": true },
    "autoExecutable": { "const": false },
    "host": {
      "type": "object",
      "required": ["distribution", "fwupdAvailable", "lvfsMetadataPresent", "packageManagers", "repositoryManagers"],
      "properties": {
        "distribution": {
          "type": "object",
          "required": ["id", "versionId", "family"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "versionId": { "type": ["string", "null"] },
            "family": { "enum": ["debian", "fedora", "arch", "suse", "unknown"] }
          },
          "additionalProperties": false
        },
        "fwupdAvailable": { "type": "boolean" },
        "lvfsMetadataPresent": { "type": "boolean" },
        "packageManagers": { "type": "array", "items": { "enum": ["apt", "dnf", "rpm-ostree", "pacman", "zypper"] }, "uniqueItems": true },
        "repositoryManagers": { "type": "array", "items": { "enum": ["apt", "dnf", "zypper", "pacman"] }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["devices", "matched", "healthy", "attention", "operations"],
      "properties": {
        "devices": { "type": "integer", "minimum": 0 },
        "matched": { "type": "integer", "minimum": 0 },
        "healthy": { "type": "integer", "minimum": 0 },
        "attention": { "type": "integer", "minimum": 0 },
        "operations": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["class", "ref"],
      "properties": {
        "class": { "enum": ["kernel-in-tree", "linux-firmware", "distribution-repository", "fwupd-lvfs", "vendor-official-repository"] },
        "ref": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string" },
        "rollback": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["id", "deviceKey", "kind", "state", "requiresPrivilege", "reason", "sources", "rollback"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "deviceKey": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["diagnose-unbound", "review-module", "review-firmware", "review-package", "review-fwupd"] },
        "state": { "const": "proposed" },
        "requiresPrivilege": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 },
        "modalias": { "type": ["string", "null"] },
        "capability": { "enum": ["available", "unavailable"] },
        "packageManager": { "type": ["string", "null"], "enum": ["apt", "dnf", "rpm-ostree", "pacman", "zypper", null] },
        "moduleCandidates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "firmwareCandidates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "packageCandidates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "rollback": { "enum": ["not-required", "required-before-apply", "source-supported"] }
      },
      "additionalProperties": false
    }
  }
}
