{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.github.io/system/contracts/driver-plan.schema.json",
  "title": "SWIR Driver Plan 0.1",
  "type": "object",
  "required": ["schema", "generatedAt", "mode", "readOnly", "autoExecutable", "summary", "operations"],
  "properties": {
    "schema": { "const": "swir.driver-plan/0.1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "mode": { "const": "preview" },
    "readOnly": { "const": true },
    "autoExecutable": { "const": false },
    "summary": {
      "type": "object",
      "required": ["devices", "matched", "healthy", "attention", "operations"],
      "properties": {
        "devices": { "type": "integer", "minimum": 0 },
        "matched": { "type": "integer", "minimum": 0 },
        "healthy": { "type": "integer", "minimum": 0 },
        "attention": { "type": "integer", "minimum": 0 },
        "operations": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["class", "ref"],
      "properties": {
        "class": { "enum": ["kernel-in-tree", "linux-firmware", "distribution-repository", "fwupd-lvfs", "vendor-official-repository"] },
        "ref": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string" },
        "rollback": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["id", "deviceKey", "kind", "state", "requiresPrivilege", "reason", "sources", "rollback"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "deviceKey": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["diagnose-unbound", "review-module", "review-firmware", "review-package", "review-fwupd"] },
        "state": { "const": "proposed" },
        "requiresPrivilege": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 },
        "moduleCandidates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "firmwareCandidates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "packageCandidates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "rollback": { "enum": ["not-required", "required-before-apply", "source-supported"] }
      },
      "additionalProperties": false
    }
  }
}
