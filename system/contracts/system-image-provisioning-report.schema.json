{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.dev/schemas/system-image-provisioning-report.schema.json",
  "title": "SWIR System Image Provisioning Report 0.1",
  "type": "object",
  "required": ["schema", "readOnlyVerification", "production", "rootfs", "ready", "bootableImageClaim", "checks", "blockers"],
  "properties": {
    "schema": { "const": "swir.system-image-provisioning-report/0.1" },
    "readOnlyVerification": { "const": true },
    "production": { "type": "boolean" },
    "rootfs": { "type": "string", "minLength": 2 },
    "ready": { "type": "boolean" },
    "bootableImageClaim": { "const": false },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "required", "passed", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "required": { "type": "boolean" },
          "passed": { "type": "boolean" },
          "detail": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
  },
  "additionalProperties": false
}
