{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.github.io/system/contracts/driver-center-report.schema.json",
  "title": "SWIR Driver Center Report 0.1",
  "type": "object",
  "required": ["schema", "generatedAt", "mode", "readOnly", "autoMutation", "host", "policy", "summary", "devices", "operations", "violations"],
  "properties": {
    "schema": { "const": "swir.driver-center-report/0.1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "mode": { "const": "diagnostics" },
    "readOnly": { "const": true },
    "autoMutation": { "const": false },
    "host": { "type": "object" },
    "policy": {
      "type": "object",
      "required": ["unknownHardwareMayAutoDownload", "arbitraryDriverUrls", "windowsKernelDriversAsLinuxDrivers", "privilegedMutationRequiresPlan", "privilegedMutationRequiresJournal"],
      "properties": {
        "unknownHardwareMayAutoDownload": { "const": false },
        "arbitraryDriverUrls": { "const": false },
        "windowsKernelDriversAsLinuxDrivers": { "const": false },
        "privilegedMutationRequiresPlan": { "const": true },
        "privilegedMutationRequiresJournal": { "const": true }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["devices", "healthy", "attention", "unknown", "unbound", "operations", "violations"],
      "properties": {
        "devices": { "type": "integer", "minimum": 0 },
        "healthy": { "type": "integer", "minimum": 0 },
        "attention": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "unbound": { "type": "integer", "minimum": 0 },
        "operations": { "type": "integer", "minimum": 0 },
        "violations": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "bus", "ids", "status", "driver", "catalog", "reasons"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "bus": { "enum": ["pci", "usb", "platform"] },
          "ids": { "type": "object" },
          "status": { "enum": ["healthy", "attention", "unknown"] },
          "driver": { "type": "object" },
          "catalog": { "type": "object" },
          "reasons": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "operations": { "type": "array" },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "deviceKey": { "type": ["string", "null"] },
          "operationId": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
