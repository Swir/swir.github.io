{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.example/contracts/system-image-readiness.schema.json",
  "title": "SWIR System Image Readiness 0.1",
  "type": "object",
  "required": ["schema", "readOnly", "generatedAt", "distribution", "architecture", "kernelRelease", "gates", "summary"],
  "properties": {
    "schema": { "const": "swir.system-image-readiness/0.1" },
    "readOnly": { "const": true },
    "generatedAt": { "type": "string", "format": "date-time" },
    "distribution": { "type": "object" },
    "architecture": { "type": "string" },
    "kernelRelease": { "type": "string" },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "required", "passed", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "passed": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["requiredPassed", "requiredTotal", "optionalPassed", "optionalTotal", "baseReady", "securityReady", "networkReady", "systemImageReadyForE2E", "blockers"],
      "properties": {
        "requiredPassed": { "type": "integer", "minimum": 0 },
        "requiredTotal": { "type": "integer", "minimum": 1 },
        "optionalPassed": { "type": "integer", "minimum": 0 },
        "optionalTotal": { "type": "integer", "minimum": 0 },
        "baseReady": { "type": "boolean" },
        "securityReady": { "type": "boolean" },
        "networkReady": { "type": "boolean" },
        "systemImageReadyForE2E": { "type": "boolean" },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
