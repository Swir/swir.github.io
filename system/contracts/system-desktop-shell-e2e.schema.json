{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.github.io/system/contracts/system-desktop-shell-e2e.schema.json",
  "title": "SWIR System Desktop Shell E2E 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "passed", "user", "uid", "sessionId", "sessionService", "remoteSession", "waylandCompositor", "waylandBackend", "waylandSocket", "runtime", "runtimePackage", "runtimeVersion", "runtimePid", "runtimeUidMatchesSession", "webProcessObserved", "shellEntry", "shellEntrySha256", "integrityManifestSha256", "shellAssetCount", "shellIntegrityVerified", "localFileOrigin", "remoteShellUrlRequired", "authenticatedGraphicalSession", "secureBootClaim", "hardwareQualificationClaim"],
  "properties": {
    "schema": {"const":"swir.system-desktop-shell-e2e/0.1"},
    "generatedAt": {"type":"string","format":"date-time"},
    "passed": {"const":true},
    "user": {"const":"swir-e2e"},
    "uid": {"type":"integer","minimum":1000},
    "sessionId": {"type":"string","minLength":1,"maxLength":64},
    "sessionService": {"const":"greetd"},
    "remoteSession": {"const":false},
    "waylandCompositor": {"const":"weston"},
    "waylandBackend": {"const":"headless"},
    "waylandSocket": {"type":"string","minLength":1,"maxLength":128},
    "runtime": {"const":"cog-wpe-webkit"},
    "runtimePackage": {"const":"cog"},
    "runtimeVersion": {"type":"string","minLength":1,"maxLength":128},
    "runtimePid": {"type":"integer","minimum":2},
    "runtimeUidMatchesSession": {"const":true},
    "webProcessObserved": {"const":true},
    "shellEntry": {"const":"/usr/share/swir-shell/swir-desktop.html"},
    "shellEntrySha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "integrityManifestSha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "shellAssetCount": {"type":"integer","minimum":20},
    "shellIntegrityVerified": {"const":true},
    "localFileOrigin": {"const":true},
    "remoteShellUrlRequired": {"const":false},
    "authenticatedGraphicalSession": {"const":true},
    "secureBootClaim": {"const":false},
    "hardwareQualificationClaim": {"const":false}
  }
}
