{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.dev/schemas/system-session-inventory.schema.json",
  "title": "SWIR System Session Inventory 0.1",
  "type": "object",
  "required": ["schema", "provider", "available", "readOnly", "mutationCapable", "arbitrarySessionOverride", "secretsExposed", "sessions", "activeActor", "probe"],
  "properties": {
    "schema": { "const": "swir.system-session-inventory/0.1" },
    "provider": { "const": "systemd-logind" },
    "available": { "type": "boolean" },
    "readOnly": { "const": true },
    "mutationCapable": { "const": false },
    "arbitrarySessionOverride": { "const": false },
    "secretsExposed": { "const": false },
    "sessions": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/session" }
    },
    "activeActor": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/actor" }
      ]
    },
    "probe": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "session": {
      "type": "object",
      "required": ["id", "uid", "username", "actorId", "active", "remote", "state", "type", "class", "seat", "service", "display", "tty", "leaderPid", "graphical", "eligibleActiveLocalUser"],
      "properties": {
        "id": { "type": ["string", "null"], "maxLength": 128 },
        "uid": { "type": ["integer", "null"], "minimum": 0 },
        "username": { "type": ["string", "null"], "maxLength": 128 },
        "actorId": { "type": ["string", "null"], "pattern": "^uid:[0-9]+$" },
        "active": { "type": "boolean" },
        "remote": { "type": "boolean" },
        "state": { "type": "string", "maxLength": 32 },
        "type": { "type": "string", "maxLength": 32 },
        "class": { "type": "string", "maxLength": 32 },
        "seat": { "type": ["string", "null"], "maxLength": 128 },
        "service": { "type": ["string", "null"], "maxLength": 128 },
        "display": { "type": ["string", "null"], "maxLength": 128 },
        "tty": { "type": ["string", "null"], "maxLength": 128 },
        "leaderPid": { "type": ["integer", "null"], "minimum": 1 },
        "graphical": { "type": "boolean" },
        "eligibleActiveLocalUser": { "type": "boolean" },
        "probeError": { "type": "string", "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": ["schema", "actorId", "uid", "username", "sessionId", "seat", "type", "leaderPid", "source", "local", "active", "authenticatedBySessionManager"],
      "properties": {
        "schema": { "const": "swir.system-session-actor/0.1" },
        "actorId": { "type": "string", "pattern": "^uid:[1-9][0-9]*$" },
        "uid": { "type": "integer", "minimum": 1 },
        "username": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "seat": { "type": ["string", "null"], "maxLength": 128 },
        "type": { "enum": ["wayland", "x11"] },
        "leaderPid": { "type": ["integer", "null"], "minimum": 1 },
        "source": { "const": "systemd-logind" },
        "local": { "const": true },
        "active": { "const": true },
        "authenticatedBySessionManager": { "const": false }
      },
      "additionalProperties": false
    }
  }
}
