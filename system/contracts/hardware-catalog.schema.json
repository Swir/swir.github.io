{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.github.io/system/contracts/hardware-catalog.schema.json",
  "title": "SWIR Hardware Catalog 0.1",
  "type": "object",
  "required": ["schema", "version", "entries"],
  "properties": {
    "schema": { "const": "swir.hardware-catalog/0.1" },
    "version": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "match", "support", "sources"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "name": { "type": "string" },
        "match": {
          "type": "object",
          "required": ["bus", "ids"],
          "properties": {
            "bus": { "enum": ["pci", "usb", "platform"] },
            "ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[A-Za-z0-9:_.*-]+$" }
            }
          },
          "additionalProperties": false
        },
        "support": {
          "type": "object",
          "properties": {
            "kernelModules": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_.+-]+$" } },
            "firmware": { "type": "array", "items": { "type": "string" } },
            "packages": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "string" }
          },
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["class", "ref"],
            "properties": {
              "class": {
                "enum": [
                  "kernel-in-tree",
                  "linux-firmware",
                  "distribution-repository",
                  "fwupd-lvfs",
                  "vendor-official-repository"
                ]
              },
              "ref": { "type": "string", "minLength": 1 },
              "repositoryId": { "type": "string" },
              "rollback": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
