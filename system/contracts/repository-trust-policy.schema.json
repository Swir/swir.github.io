{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.local/contracts/repository-trust-policy.schema.json",
  "title": "SWIR System Repository Trust Policy 0.1",
  "type": "object",
  "required": ["schema", "defaultRepositoryId", "repositories"],
  "properties": {
    "schema": { "const": "swir.system-repository-trust-policy/0.1" },
    "defaultRepositoryId": { "type": ["string", "null"] },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "manager", "nativeId", "sourceClass", "distributions", "signatureVerification", "allowInsecure", "enabled"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 192 },
          "manager": { "enum": ["apt", "dnf", "rpm-ostree", "pacman", "zypper"] },
          "nativeId": { "type": "string", "minLength": 1, "maxLength": 192 },
          "sourceClass": { "const": "distribution-repository" },
          "distributions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 192 } },
          "signatureVerification": { "const": "native-required" },
          "allowInsecure": { "const": false },
          "enabled": { "const": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
