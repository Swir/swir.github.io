{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.example/contracts/windows-compat-live-e2e.schema.json",
  "title": "SWIR Windows Compatibility Live E2E 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "generatedAt", "platform", "provider", "runtimeFamily", "runtimeExecutable", "runtimeVersion",
    "runtimeRootOwned", "runtimeWritableByGroupOrWorld", "runtimeHealthy", "prefixPolicy", "prefixContained",
    "metadataBound", "trustVerified", "signatureRequired", "brokerRequired", "shellExecution",
    "windowsExecutableExtension", "processStarted", "processExited", "exitCode", "markerProduced", "markerContent",
    "arbitraryRuntimeDownloadAllowed", "windowsKernelDriverSupport", "realWineExecution", "passed"
  ],
  "properties": {
    "schema": { "const": "swir.windows-compat-live-e2e/0.1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "platform": { "const": "linux" },
    "provider": { "const": "swir.compat.wine" },
    "runtimeFamily": { "const": "wine" },
    "runtimeExecutable": { "type": "string", "pattern": "^/" },
    "runtimeVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
    "runtimeRootOwned": { "const": true },
    "runtimeWritableByGroupOrWorld": { "const": false },
    "runtimeHealthy": { "const": true },
    "prefixPolicy": { "const": "per-app" },
    "prefixContained": { "const": true },
    "metadataBound": { "const": true },
    "trustVerified": { "const": true },
    "signatureRequired": { "const": true },
    "brokerRequired": { "const": true },
    "shellExecution": { "const": false },
    "windowsExecutableExtension": { "const": ".exe" },
    "processStarted": { "const": true },
    "processExited": { "const": true },
    "exitCode": { "const": 0 },
    "markerProduced": { "const": true },
    "markerContent": { "const": "SWIR_WINE_E2E_OK" },
    "arbitraryRuntimeDownloadAllowed": { "const": false },
    "windowsKernelDriverSupport": { "const": false },
    "realWineExecution": { "const": true },
    "passed": { "const": true }
  }
}
