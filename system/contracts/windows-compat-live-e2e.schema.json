{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.dev/contracts/windows-compat-live-e2e.schema.json",
  "title": "SWIR Windows compatibility live E2E evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "provider",
    "runtimeFamily",
    "runtimeVersion",
    "runtimeExecutable",
    "runtimeRootOwned",
    "runtimeGroupWorldWritable",
    "runtimeHealthy",
    "appId",
    "fixtureSha256",
    "executionClass",
    "perAppPrefix",
    "prefixInsideManagedRoot",
    "trustVerified",
    "signatureRequired",
    "brokerRequired",
    "shellExecution",
    "processStarted",
    "processExitCode",
    "processSignal",
    "arbitraryRuntimeDownloadAllowed",
    "windowsKernelDriverSupport",
    "hardwareQualificationClaim",
    "passed"
  ],
  "properties": {
    "schema": { "const": "swir.windows-compat-live-e2e/0.1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "provider": { "const": "swir.compat.wine" },
    "runtimeFamily": { "const": "wine" },
    "runtimeVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
    "runtimeExecutable": { "type": "string", "pattern": "^/" },
    "runtimeRootOwned": { "const": true },
    "runtimeGroupWorldWritable": { "const": false },
    "runtimeHealthy": { "const": true },
    "appId": { "const": "swir.e2e.windows.userapp" },
    "fixtureSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executionClass": { "const": "windows-compat" },
    "perAppPrefix": { "const": true },
    "prefixInsideManagedRoot": { "const": true },
    "trustVerified": { "const": true },
    "signatureRequired": { "const": true },
    "brokerRequired": { "const": true },
    "shellExecution": { "const": false },
    "processStarted": { "const": true },
    "processExitCode": { "const": 0 },
    "processSignal": { "type": "null" },
    "arbitraryRuntimeDownloadAllowed": { "const": false },
    "windowsKernelDriverSupport": { "const": false },
    "hardwareQualificationClaim": { "const": false },
    "passed": { "const": true }
  }
}
